# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=

# PortOne identity verification
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
IDENTITY_HASH_SECRET=

# Pilldata Chat API
# 로컬 개발 예시: http://127.0.0.1:8000
PILLDATA_CHAT_API_URL=
PILLDATA_CHAT_API_KEY=

# Pill Image Recognition API
# 예시: http://100.52.237.132:8010
PILL_IMAGE_API_URL=
PILL_IMAGE_API_KEY=

# 식약처 공공데이터 API (data.go.kr)
MFDS_API_KEY=
MFDS_EASY_API_KEY=
# 낱알식별 API (모양 검색용) — data.go.kr에서 "의약품 낱알식별 정보 서비스" 별도 신청 필요
MFDS_GRAIN_API_KEY=

# 네이버 지도 API (console.ncloud.com — Application 등록 후 "Maps" 서비스 선택)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 네이버 검색 API (developers.naver.com — "지역" 검색 API 신청)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오 REST API (developers.kakao.com — 앱 생성 후 "REST API 키" 복사)
# 근처 약국 지도 검색에 사용 (뷰포트 기반 좌표 검색)
KAKAO_REST_API_KEY=
